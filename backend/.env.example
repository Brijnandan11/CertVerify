NODE_ENV=development
PORT=4000
# Example local Postgres URL. Replace with your own connection string if needed.
DATABASE_URL=postgresql://certverify:certverify@localhost:5439/certverify
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
